# All settings are optional; defaults live in src/huflit_qa/config.py.
# Build-time settings are recorded in <index>/manifest.json and reused at query time.
# HUFLIT_INDEX_PATH=data/index
# HUFLIT_CHUNKING__STRATEGY=v1            # v1 | v2
# HUFLIT_CHUNKING__MAX_WORDS=200          # v2 only
# HUFLIT_CHUNKING__CONTEXT_PREFIX=false
# HUFLIT_BM25__TOKENIZER=whitespace       # whitespace | words | pyvi
# HUFLIT_EMBEDDING__MODEL=paraphrase-multilingual-MiniLM-L12-v2
# HUFLIT_EMBEDDING__MAX_SEQ_LENGTH=512
# HUFLIT_EMBEDDING__LOWERCASE_QUERY=true
# HUFLIT_RETRIEVAL__TOP_K=10
# HUFLIT_RETRIEVAL__RRF_K=60
